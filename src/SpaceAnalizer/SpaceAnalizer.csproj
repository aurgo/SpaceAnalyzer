<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SpaceAnalizer: a single, tiny, portable executable.
    No NuGet packages and no UI framework: the UI is drawn by hand on top of the native APIs
    (Win32 + GDI/GDI+ on Windows, AppKit + CoreGraphics/CoreText on macOS) through P/Invoke.

    Publish (framework-dependent, a few hundred KB, needs the .NET 10 runtime):
      dotnet publish -c Release -r win-x64
    Publish with Native AOT (no dependencies at all, ~2 MB; must be built on the target OS):
      dotnet publish -c Release -r win-x64 -p:PublishAot=true
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SpaceAnalizer</AssemblyName>
    <RootNamespace>SpaceAnalizer</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>

    <!-- Small and self-sufficient: no ICU, no satellite resources, no reflection. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- dotnet publish -r <rid>: one single file, framework-dependent unless PublishAot is set. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' != 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpaceAnalizer.Tests" />
  </ItemGroup>

  <!-- Inter (SIL OFL 1.1), baked into a tiny outline format by tools/FontBaker.cs and embedded in the executable. -->
  <ItemGroup>
    <EmbeddedResource Include="Render/Fonts/*.saf" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
